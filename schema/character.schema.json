{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wrc2tuning/Link-Box.Ai-Desk-Agent-Packs/schema/character.schema.json",
  "title": "Master Harness character pack manifest (character.json)",
  "type": "object",
  "required": ["schema_version", "kind", "id", "name", "version", "license", "model", "clips", "rig"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "character"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "license": {"type": "object", "required": ["spdx", "redistributable"], "properties": {"spdx": {"type": "string"}, "redistributable": {"type": "boolean"}, "source": {"type": "string"}}},
    "model": {"type": "object", "required": ["file"], "properties": {
      "file": {"type": "string", "pattern": "\\.glb$"}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": ["integer", "null"]},
      "facing_yaw": {"type": "number"}, "framing_fill": {"type": "number", "minimum": 0.5, "maximum": 1.0}, "sole_bleed": {"type": "number"}, "height_units": {"type": "number"}}},
    "window": {"type": "object", "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}},
    "clips": {"type": "object", "required": ["prefix", "loops", "pools"], "properties": {
      "prefix": {"type": "string"}, "loops": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "one_shots": {"type": "array", "items": {"type": "string"}},
      "accents": {"type": "array", "items": {"type": "string"}}, "accent_seconds": {"type": "number"}, "accent_every": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
      "pools": {"type": "object", "required": ["rest", "listen", "watching", "think", "speak", "work"], "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
      "idle_accents": {"type": "array", "items": {"type": "string"}}, "protected": {"type": "array", "items": {"type": "string"}}, "look_reduced_scale": {"type": "number"},
      "click": {"type": "object", "properties": {"head": {"type": "array"}, "hand": {"type": "array"}, "torso": {"type": "array"}}},
      "state": {"type": "object"}}},
    "rig": {"type": "object", "required": ["root", "pelvis", "feet", "arms", "look"], "properties": {
      "root": {"type": "string"}, "pelvis": {"type": "string"}, "chest": {"type": "array", "items": {"type": "string"}}, "hips_locked": {"type": "array", "items": {"type": "string"}},
      "feet": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "thighs": {"type": "array", "items": {"type": "string"}},
      "arms": {"type": "object", "properties": {"L": {"$ref": "#/$defs/arm"}, "R": {"$ref": "#/$defs/arm"}}},
      "look": {"type": "object", "required": ["order", "weights"], "properties": {"order": {"type": "array", "items": {"type": "string"}}, "weights": {"type": "object", "additionalProperties": {"type": "number"}}, "yaw_only": {"type": "array"}, "head_clamp_deg": {"type": "number"}, "base_yaw_deg": {"type": "number"}, "base_pitch_deg": {"type": "number"}}},
      "body_bone_regex": {"type": "string"}, "thigh_regex": {"type": "string"},
      "zones": {"type": "object"}, "scale": {"type": "object", "additionalProperties": {"type": "number"}}}},
    "preview": {"type": "string"}
  },
  "$defs": {"arm": {"type": "object", "required": ["upper", "fore", "hand"], "properties": {"upper": {"type": "string"}, "fore": {"type": "string"}, "hand": {"type": "string"}, "outward": {"type": "number"}}}}
}
